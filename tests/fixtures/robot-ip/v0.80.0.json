      "errors": [404],
      "quota": {"requests": 5000, "seconds": 3600}
    },
    {
      "id": "robot_get_ip",
      "method": "GET",
      "path": "/ip/{ip}",
      "request_fields": [],
      "success": {"status": 200, "body": "json", "shape": "ip-detail"},
      "errors": [404],
      "quota": {"requests": 5000, "seconds": 3600}
    },
    {
      "id": "robot_update_ip",
      "method": "POST",
      "path": "/ip/{ip}",
      "request_fields": ["traffic_warnings?", "traffic_hourly?", "traffic_daily?", "traffic_monthly?"],
      "success": {"status": 200, "body": "json", "shape": "ip-detail"},
      "errors": [400, 404, 500],
      "quota": {"requests": 5000, "seconds": 3600}
    },
    {
      "id": "robot_get_ip_mac",
      "method": "GET",
      "path": "/ip/{ip}/mac",
      "request_fields": [],
      "success": {"status": 200, "body": "json", "shape": "mac-present"},
      "errors": [404],
      "quota": {"requests": 5000, "seconds": 3600}
    },
    {
      "id": "robot_set_ip_mac",
      "method": "PUT",
      "path": "/ip/{ip}/mac",
      "request_fields": [],
      "success": {"status": 200, "body": "json", "shape": "mac-present"},
      "errors": [404, 409, 500],
      "quota": {"requests": 10, "seconds": 3600}
    },
    {
      "id": "robot_delete_ip_mac",
      "method": "DELETE",
      "path": "/ip/{ip}/mac",
      "request_fields": [],
      "success": {"status": 200, "body": "json", "shape": "mac-null"},
      "errors": [404, 409, 500],
      "quota": {"requests": 10, "seconds": 3600}
    }
  ],
  "summary_fields": [
    "ip", "server_ip", "server_number", "locked", "separate_mac",
    "traffic_warnings", "traffic_hourly", "traffic_daily", "traffic_monthly"
